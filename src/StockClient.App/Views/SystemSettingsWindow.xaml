<Window x:Class="StockClient.App.Views.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#12161F" FontFamily="Microsoft YaHei" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Margin="6,8,6,6">
    <TabItem Header="系统">
      <StackPanel Margin="14,16,14,18">
        <TextBlock Text="更新" Foreground="#EDF1F7" Margin="0,0,0,8" />
        <CheckBox x:Name="AutoUpdateBox" Content="自动更新" Foreground="#EDF1F7"
                  Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" />
        <TextBlock Margin="26,4,0,0" FontSize="11" Foreground="#5F6672" TextWrapping="Wrap"
                   Text="发现新版本后，仅当系统连续 10 分钟无键鼠输入时才静默下载、安装并重启（重启后自动登录，简洁面板开着会自动恢复）。关闭后仅保留底部提示条的手动更新。" />

        <Separator Margin="0,16,0,14" Background="#232B3B" />

        <TextBlock Text="关于" Foreground="#EDF1F7" Margin="0,0,0,6" />
        <TextBlock x:Name="VersionText" Foreground="#8B93A3" />
        <TextBlock FontSize="11" Foreground="#5F6672" Margin="0,4,0,0"
                   Text="手动检查更新：主界面右上角「检查更新」。" />
      </StackPanel>
    </TabItem>
    <TabItem Header="简洁面板">
      <ContentControl x:Name="PanelHost" />
    </TabItem>
  </TabControl>
</Window>
