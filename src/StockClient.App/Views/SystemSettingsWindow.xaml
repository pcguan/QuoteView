<Window x:Class="StockClient.App.Views.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#12161F" FontFamily="Microsoft YaHei" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Margin="6,8,6,6">
    <TabItem Header="系统">
      <StackPanel Margin="14,16,14,18">
        <TextBlock Text="更新" Foreground="#EDF1F7" Margin="0,0,0,8" />
        <RadioButton x:Name="AutoSilentRadio" GroupName="au" Foreground="#EDF1F7"
                     Content="静默自动更新" Checked="AutoUpdate_Changed" />
        <TextBlock Margin="26,2,0,8" FontSize="11" Foreground="#5F6672" TextWrapping="Wrap"
                   Text="发现新版本后，等系统连续 10 分钟无键鼠输入才更新——使用中永不打扰。" />
        <RadioButton x:Name="AutoInstantRadio" GroupName="au" Foreground="#EDF1F7"
                     Content="立即自动更新" Checked="AutoUpdate_Changed" />
        <TextBlock Margin="26,2,0,8" FontSize="11" Foreground="#5F6672" TextWrapping="Wrap"
                   Text="检测到新版本立刻下载安装并重启。" />
        <RadioButton x:Name="AutoOffRadio" GroupName="au" Foreground="#EDF1F7"
                     Content="关闭自动更新" Checked="AutoUpdate_Changed" />
        <TextBlock Margin="26,2,0,0" FontSize="11" Foreground="#5F6672" TextWrapping="Wrap"
                   Text="只在底部提示条（及桌面弹窗）提示，手动点击才更新。" />
        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#5F6672" TextWrapping="Wrap"
                   Text="任一方式更新后都会按更新前的状态恢复：主窗口在前台就回到前台；最小化或简洁面板模式则全程后台完成，面板自动恢复、不打扰当前操作。" />

        <CheckBox x:Name="UpdateToastBox" Content="发现新版本时桌面弹窗提醒" Foreground="#EDF1F7"
                  Margin="0,12,0,0" Checked="UpdateToast_Changed" Unchecked="UpdateToast_Changed" />
        <TextBlock Margin="26,4,0,0" FontSize="11" Foreground="#5F6672" TextWrapping="Wrap"
                   Text="右下角弹窗，可点「后台升级」立即更新或「关闭」忽略（每个版本只弹一次，20 秒无操作自动消失）。主窗口最小化或简洁面板模式下也能看到。" />

        <Separator Margin="0,16,0,14" Background="#232B3B" />

        <TextBlock Text="网络代理" Foreground="#EDF1F7" Margin="0,0,0,8" />
        <RadioButton x:Name="ProxyOffRadio" GroupName="px" Foreground="#EDF1F7"
                     Content="不使用代理（推荐）" Checked="Proxy_Changed" />
        <TextBlock Margin="26,2,0,8" FontSize="11" Foreground="#5F6672" TextWrapping="Wrap"
                   Text="行情与服务端均为国内直连，一般无需代理；且不受本机代理软件开关的影响。" />
        <RadioButton x:Name="ProxySystemRadio" GroupName="px" Foreground="#EDF1F7"
                     Content="使用系统代理" Checked="Proxy_Changed" />
        <TextBlock Margin="26,2,0,8" FontSize="11" Foreground="#5F6672" TextWrapping="Wrap"
                   Text="跟随 Windows 的代理设置。注意：若代理软件在本程序运行中被关闭，需重启本程序恢复联网。" />
        <RadioButton x:Name="ProxyManualRadio" GroupName="px" Foreground="#EDF1F7"
                     Content="手动指定" Checked="Proxy_Changed" />
        <TextBox x:Name="ProxyAddressBox" Margin="26,6,0,0" Width="200" HorizontalAlignment="Left"
                 Background="#0F1420" Foreground="#EDF1F7" BorderBrush="#33405C"
                 LostFocus="ProxyAddress_Changed" />
        <TextBlock Margin="26,4,0,0" FontSize="11" Foreground="#5F6672" TextWrapping="Wrap"
                   Text="格式：主机:端口（如 127.0.0.1:7890）。修改代理设置重启客户端后生效。" />

        <Separator Margin="0,16,0,14" Background="#232B3B" />

        <TextBlock Text="关于" Foreground="#EDF1F7" Margin="0,0,0,6" />
        <TextBlock x:Name="VersionText" Foreground="#8B93A3" />
        <TextBlock FontSize="11" Foreground="#5F6672" Margin="0,4,0,0"
                   Text="手动检查更新：主界面右上角「检查更新」。" />
      </StackPanel>
    </TabItem>
    <TabItem Header="简洁面板">
      <ContentControl x:Name="PanelHost" />
    </TabItem>
  </TabControl>
</Window>
