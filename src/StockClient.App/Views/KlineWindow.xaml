<Window x:Class="StockClient.App.Views.KlineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StockClient.App.Views"
        Width="920" Height="580" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#0F1420" FontFamily="Microsoft YaHei"
        TextOptions.TextFormattingMode="Display">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                   Foreground="#EDF1F7" VerticalAlignment="Center" />
        <Border Background="#1E2534" BorderBrush="#2C3547" BorderThickness="1"
                CornerRadius="6" Padding="8,3" Margin="12,0,0,0">
          <TextBlock x:Name="StatusText" FontSize="11" Foreground="#8B93A3"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="HintText" Text="滚轮缩放 · 拖动平移" FontSize="11" Foreground="#5F6672"
                   VerticalAlignment="Center" Margin="12,0,0,0"
                   ToolTip="快捷键：Esc 关闭 · 1/2/3/4 分时·日K·周K·月K · ←→ 逐根平移 · PgUp/PgDn 翻页 · +/- 缩放 · Home/End 跳到最早/最新" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <StackPanel x:Name="PeriodButtons" Orientation="Horizontal" Margin="0,0,16,0" />
        <StackPanel x:Name="AdjustButtons" Orientation="Horizontal" Margin="0,0,16,0" />
        <Button Content="恢复默认" FontSize="12" Padding="11,3" Click="Reset_Click"
                ToolTip="回到最近 80 根，并显示全部均线" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="#0F1420" BorderBrush="#222A38"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <!-- Order book, only in intraday mode (collapsed otherwise, so candles
               keep the full width). -->
          <ColumnDefinition x:Name="DepthColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <views:KlineChart x:Name="Chart" Grid.Column="0" />
        <views:TrendChart x:Name="Trend" Grid.Column="0" Visibility="Collapsed" />
        <TextBlock x:Name="Overlay" Grid.Column="0" Text="加载中…" FontSize="13" Foreground="#8B93A3"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <Border x:Name="DepthPane" Grid.Column="1" Visibility="Collapsed"
                BorderBrush="#222A38" BorderThickness="1,0,0,0" Padding="10,8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />   <!-- 委比/委差 -->
              <RowDefinition Height="Auto" />   <!-- 涨停 -->
              <RowDefinition Height="Auto" />   <!-- 五档 -->
              <RowDefinition Height="Auto" />   <!-- 跌停 -->
              <RowDefinition Height="Auto" />   <!-- 统计块 -->
              <RowDefinition Height="Auto" />   <!-- 成交明细 header -->
              <RowDefinition Height="*" />      <!-- 最新分笔 tape -->
              <RowDefinition Height="Auto" />   <!-- 更多 button -->
            </Grid.RowDefinitions>

            <!-- 委比 / 委差 -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="委比" FontSize="11" Foreground="#8B93A3" HorizontalAlignment="Left" />
                <TextBlock x:Name="WeibiText" FontSize="11" Foreground="#DCE4EE" HorizontalAlignment="Right" />
              </Grid>
              <Grid Grid.Column="1">
                <TextBlock Text="委差" FontSize="11" Foreground="#8B93A3" HorizontalAlignment="Left" />
                <TextBlock x:Name="WeichaText" FontSize="11" Foreground="#DCE4EE" HorizontalAlignment="Right" />
              </Grid>
            </Grid>

            <!-- 涨停 -->
            <Grid Grid.Row="1" Margin="0,2,0,2">
              <TextBlock Text="涨停" FontSize="11" Foreground="#8B93A3" HorizontalAlignment="Left" />
              <TextBlock x:Name="LimitUpText" FontSize="11" Foreground="#EF5350" HorizontalAlignment="Right" />
            </Grid>

            <Border x:Name="DepthHost" Grid.Row="2" VerticalAlignment="Top" />

            <!-- 跌停 -->
            <Grid Grid.Row="3" Margin="0,2,0,6">
              <TextBlock Text="跌停" FontSize="11" Foreground="#8B93A3" HorizontalAlignment="Left" />
              <TextBlock x:Name="LimitDownText" FontSize="11" Foreground="#26A69A" HorizontalAlignment="Right" />
            </Grid>

            <!-- 统计块: 总手/金额 · 换手/量比 · 外盘/内盘 -->
            <StackPanel Grid.Row="4">
              <Border Height="1" Background="#222A38" Margin="0,0,0,6" />
              <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Text="总手" FontSize="11" Foreground="#8B93A3" HorizontalAlignment="Left" />
                  <TextBlock x:Name="TotalVolText" FontSize="11" Foreground="#DCE4EE" HorizontalAlignment="Right" />
                </Grid>
                <Grid Grid.Column="1">
                  <TextBlock Text="金额" FontSize="11" Foreground="#8B93A3" HorizontalAlignment="Left" />
                  <TextBlock x:Name="AmountText" FontSize="11" Foreground="#DCE4EE" HorizontalAlignment="Right" />
                </Grid>
              </Grid>
              <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Text="换手" FontSize="11" Foreground="#8B93A3" HorizontalAlignment="Left" />
                  <TextBlock x:Name="TurnoverText" FontSize="11" Foreground="#DCE4EE" HorizontalAlignment="Right" />
                </Grid>
                <Grid Grid.Column="1">
                  <TextBlock Text="量比" FontSize="11" Foreground="#8B93A3" HorizontalAlignment="Left" />
                  <TextBlock x:Name="VolRatioText" FontSize="11" Foreground="#DCE4EE" HorizontalAlignment="Right" />
                </Grid>
              </Grid>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Text="外盘" FontSize="11" Foreground="#8B93A3" HorizontalAlignment="Left" />
                  <TextBlock x:Name="OuterText" FontSize="11" Foreground="#EF5350" HorizontalAlignment="Right" />
                </Grid>
                <Grid Grid.Column="1">
                  <TextBlock Text="内盘" FontSize="11" Foreground="#8B93A3" HorizontalAlignment="Left" />
                  <TextBlock x:Name="InnerText" FontSize="11" Foreground="#26A69A" HorizontalAlignment="Right" />
                </Grid>
              </Grid>
              <Border Height="1" Background="#222A38" Margin="0,2,0,0" />
            </StackPanel>

            <!-- 成交明细 header: 最新 + 图例 + 大单阈值 -->
            <Grid x:Name="TapeHeader" Grid.Row="5" Margin="0,8,0,4">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="成交明细" FontSize="11" Foreground="#8B93A3" VerticalAlignment="Center" />
                <TextBlock Text="●" FontSize="10" Foreground="#C77DFF" VerticalAlignment="Center" Margin="8,0,0,0"
                           ToolTip="大单主动买" />
                <TextBlock Text="●" FontSize="10" Foreground="#22D3E8" VerticalAlignment="Center" Margin="2,0,0,0"
                           ToolTip="大单主动卖" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="大单≥" FontSize="10" Foreground="#5F6672" VerticalAlignment="Center" />
                <TextBox x:Name="BigTradeBox" Width="42" FontSize="10" Padding="3,1"
                         VerticalContentAlignment="Center" MaxLength="5"
                         Background="#141A26" Foreground="#EDF1F7" BorderBrush="#2C3547"
                         ToolTip="单笔成交额达到该万元数即标为大单（0 = 不高亮）" />
                <TextBlock Text="万" FontSize="10" Foreground="#5F6672"
                           VerticalAlignment="Center" Margin="3,0,0,0" />
              </StackPanel>
            </Grid>

            <views:TradeTapeView x:Name="Tape" Grid.Row="6" />

            <Button x:Name="MoreButton" Grid.Row="7" Content="查看更多成交明细" FontSize="12"
                    Margin="0,8,0,0" Padding="0,5" HorizontalAlignment="Stretch" Click="More_Click" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
