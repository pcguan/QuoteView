<Window x:Class="StockClient.App.Views.KlineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StockClient.App.Views"
        Width="920" Height="580" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#0F1420" FontFamily="Microsoft YaHei"
        TextOptions.TextFormattingMode="Display">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                   Foreground="#EDF1F7" VerticalAlignment="Center" />
        <Border Background="#1E2534" BorderBrush="#2C3547" BorderThickness="1"
                CornerRadius="6" Padding="8,3" Margin="12,0,0,0">
          <TextBlock x:Name="StatusText" FontSize="11" Foreground="#8B93A3"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="HintText" Text="滚轮缩放 · 拖动平移" FontSize="11" Foreground="#5F6672"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <StackPanel x:Name="PeriodButtons" Orientation="Horizontal" Margin="0,0,16,0" />
        <StackPanel x:Name="AdjustButtons" Orientation="Horizontal" Margin="0,0,16,0" />
        <Button Content="恢复默认" FontSize="12" Padding="11,3" Click="Reset_Click"
                ToolTip="回到最近 80 根，并显示全部均线" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="#0F1420" BorderBrush="#222A38"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <views:KlineChart x:Name="Chart" />
        <views:TrendChart x:Name="Trend" Visibility="Collapsed" />
        <TextBlock x:Name="Overlay" Text="加载中…" FontSize="13" Foreground="#8B93A3"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />
      </Grid>
    </Border>
  </Grid>
</Window>
