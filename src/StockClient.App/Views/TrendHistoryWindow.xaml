<Window x:Class="StockClient.App.Views.TrendHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StockClient.App.Views"
        Width="1040" Height="620" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#0F1420" FontFamily="Microsoft YaHei"
        TextOptions.TextFormattingMode="Display">
  <!-- Hosts a fresh TrendHistoryView (a pure disk reader, no shared mutable
       state), so it opens beside the stealth panel without touching it. -->
  <views:TrendHistoryView x:Name="History" />
</Window>
