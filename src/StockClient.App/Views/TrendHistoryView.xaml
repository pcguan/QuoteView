<UserControl x:Class="StockClient.App.Views.TrendHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:StockClient.App.Views">
  <Grid Margin="16,4,16,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="分组" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <ComboBox x:Name="GroupBox" Width="170" DisplayMemberPath="Name"
                  DropDownOpened="GroupBox_DropDownOpened"
                  SelectionChanged="GroupBox_SelectionChanged" />

        <TextBlock Text="合约" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                   Margin="18,0,8,0" />
        <ComboBox x:Name="CodeBox" Width="230"
                  SelectionChanged="CodeBox_SelectionChanged" />

        <TextBlock Text="日期" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                   Margin="18,0,8,0" />
        <ComboBox x:Name="DateBox" Width="150"
                  DropDownOpened="DateBox_DropDownOpened"
                  SelectionChanged="DateBox_SelectionChanged" />

        <TextBlock x:Name="Hint" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="11"
                   Foreground="{StaticResource Faint}"
                   Text="收盘后自动为全部分组的沪深合约拉取当日分时并保留 7 天；当天的在收盘约 20 分钟后陆续可见。" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
      <Grid>
        <views:TrendChart x:Name="Chart" />
        <TextBlock x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Foreground="{StaticResource Muted}" Visibility="Collapsed" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
