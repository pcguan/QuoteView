<Window x:Class="StockClient.App.Views.StealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="行情" WindowStyle="None" AllowsTransparency="True"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Background="Transparent"
        FontFamily="Microsoft YaHei"
        MouseLeftButtonDown="Root_Drag">
  <!--
    Background is #01000000, not Transparent: a fully transparent surface isn't
    hit-testable, so the panel could be neither dragged nor right-clicked.
    One alpha step is invisible but still catches the mouse.
  -->
  <!--
    Double-click hides the panel; double-clicking its old position restores it.
    Left press waits for the system drag threshold before DragMove, leaving
    hold-left + wheel available for groups. Hold-right + wheel adjusts shade;
    releasing after scrolling suppresses the context menu. A plain right click
    still opens the menu and a plain wheel still walks contracts.
  -->
  <!--
    No ToolTip here, deliberately.

    The panel is one 20px line and lives at the bottom of the screen, so a
    tooltip has no room to open downward and Windows flips it up — a 288x104 box
    landing exactly on top of the 179x20 ticker. Touching the panel then hid the
    quotes behind a help bubble, which is the opposite of what a always-on-top
    ticker is for. (It also read as the panel "turning into two lines" while
    being dragged.) The right-click menu carries the same shortcuts.
  -->
  <!-- Padding is generous vertically on purpose: it is the panel's hit area.
       At 2px the window was ~20px tall with one row, and the pointer slid off it
       mid-scroll, so the wheel silently went to the window underneath — which
       read as "scrolling is unreliable". The background is all but transparent,
       so the extra height doesn't show. -->
  <Border x:Name="Root" Background="#01000000" CornerRadius="4" Padding="10,8">
    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
      <!-- Intraday sparkline of the current contract; the child is set in code and
           this host stays collapsed unless the trend option is on. -->
      <Border x:Name="SparkHost" Visibility="Collapsed" Margin="0,1,0,3" />
      <!-- Group name on the left, quote rows on the right. The name is vertically
           centred against the whole block rather than sitting above it, so a
           multi-row panel doesn't grow a header line — height is the scarcest
           thing here. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Vertical: one character per line (set in Render), hugging the left
             edge — a horizontal name cost ~76px, this costs one glyph's width. -->
        <TextBlock x:Name="GroupLabel" Grid.Column="0"
                   VerticalAlignment="Center" Margin="0,0,7,0"
                   FontSize="10" Foreground="#8B93A3" TextAlignment="Center"
                   LineHeight="12" LineStackingStrategy="BlockLineHeight" />

        <!-- One StackPanel row per contract; each row is filled with field TextBlocks in Render. -->
        <StackPanel x:Name="Rows" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
