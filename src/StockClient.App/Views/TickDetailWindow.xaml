<Window x:Class="StockClient.App.Views.TickDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="680" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#0F1420" FontFamily="Microsoft YaHei"
        TextOptions.TextFormattingMode="Display">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: name/code + counts + refresh -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="#EDF1F7"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="CountText" FontSize="11" Foreground="#8B93A3"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>
      <Button x:Name="RefreshButton" Content="刷新" FontSize="12" Padding="12,3"
              HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click" />
    </Grid>

    <!-- Filter: 全部 / ≥100 / ≥1000 / ≥10000 手 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="筛选" FontSize="12" Foreground="#8B93A3" VerticalAlignment="Center"
                 Margin="0,0,10,0" />
      <StackPanel x:Name="FilterButtons" Orientation="Horizontal" />
      <TextBlock x:Name="Hint" FontSize="11" Foreground="#5F6672" VerticalAlignment="Center"
                 Margin="14,0,0,0" Text="按单笔成交量(手)过滤" />
    </StackPanel>

    <!-- Detail table -->
    <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="None" CanUserSortColumns="False"
              CanUserResizeRows="False" Background="Transparent" RowBackground="Transparent"
              BorderBrush="#222A38" BorderThickness="1" FontSize="12"
              EnableRowVirtualization="True" EnableColumnVirtualization="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="130">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="#8B93A3" />
              <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="成交价" Binding="{Binding Price}" Width="115">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{Binding Fg}" />
              <Setter Property="FontWeight" Value="{Binding Weight}" />
              <Setter Property="TextAlignment" Value="Right" />
              <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="量(手)" Binding="{Binding Volume}" Width="110">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{Binding Fg}" />
              <Setter Property="FontWeight" Value="{Binding Weight}" />
              <Setter Property="TextAlignment" Value="Right" />
              <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="方向" Binding="{Binding SideText}" Width="100">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{Binding Fg}" />
              <Setter Property="TextAlignment" Value="Center" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Pagination -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                Margin="0,10,0,0">
      <Button x:Name="FirstButton" Content="⏮" FontSize="12" Padding="8,3" Click="First_Click" />
      <Button x:Name="PrevButton" Content="上一页" FontSize="12" Padding="10,3" Margin="6,0,0,0"
              Click="Prev_Click" />
      <TextBlock x:Name="PageText" FontSize="12" Foreground="#EDF1F7" VerticalAlignment="Center"
                 Margin="12,0,12,0" MinWidth="96" TextAlignment="Center" />
      <Button x:Name="NextButton" Content="下一页" FontSize="12" Padding="10,3" Click="Next_Click" />
      <Button x:Name="LastButton" Content="⏭" FontSize="12" Padding="8,3" Margin="6,0,0,0"
              Click="Last_Click" />
    </StackPanel>
  </Grid>
</Window>
