<UserControl x:Class="StockClient.App.Views.BriefView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid Margin="16,4,16,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: which day, where it came from, and any source that failed -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="每日信息聚合" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleGradient}" />
            <Border Style="{StaticResource Badge}" Margin="12,0,0,0" Padding="8,2">
              <TextBlock x:Name="DayText" FontSize="11" Foreground="{StaticResource Muted}" />
            </Border>
          </StackPanel>
          <TextBlock x:Name="SubtitleText" FontSize="11" Margin="0,6,0,0"
                     Foreground="{StaticResource Faint}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <ComboBox x:Name="DayPicker" Width="130" Height="30" Margin="0,0,8,0"
                    SelectionChanged="DayPicker_Changed" ToolTip="选择日期" />
          <ui:Button Height="30" Width="32" Padding="0" Icon="{ui:SymbolIcon ArrowSync24}"
                     Click="Refresh_Click" ToolTip="重新读取本地简报" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Empty state: no brief on this machine yet -->
    <Border x:Name="EmptyPane" Grid.Row="1" Style="{StaticResource Card}"
            Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="本机还没有简报" FontSize="14" Foreground="{StaticResource Muted}"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptyHint" FontSize="11" Margin="0,8,0,0" TextAlignment="Center"
                   Foreground="{StaticResource Faint}" TextWrapping="Wrap" MaxWidth="460" />
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Sections" />
    </ScrollViewer>
  </Grid>
</UserControl>
