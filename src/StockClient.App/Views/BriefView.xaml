<UserControl x:Class="StockClient.App.Views.BriefView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid Margin="16,4,16,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: which day, where it came from, and any source that failed -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="每日信息聚合" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleGradient}" />
            <Border Style="{StaticResource Badge}" Margin="12,0,0,0" Padding="8,2">
              <TextBlock x:Name="DayText" FontSize="11" Foreground="{StaticResource Muted}" />
            </Border>
          </StackPanel>
          <TextBlock x:Name="SubtitleText" FontSize="11" Margin="0,6,0,0"
                     Foreground="{StaticResource Faint}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <!-- Wide enough for 2026-08-05 plus the drop-down glyph; the raw
               yyyyMMdd form in a narrower box was getting clipped. -->
          <ComboBox x:Name="DayPicker" Width="160" Height="32" Margin="0,0,8,0"
                    Padding="10,0,6,0" VerticalContentAlignment="Center"
                    DisplayMemberPath="Label" SelectedValuePath="Key"
                    SelectionChanged="DayPicker_Changed" ToolTip="选择交易日" />
          <ui:Button Height="32" Width="34" Padding="0" Icon="{ui:SymbolIcon ArrowSync24}"
                     Click="Refresh_Click" ToolTip="重新读取本地简报" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Empty state: no brief on this machine yet -->
    <Border x:Name="EmptyPane" Grid.Row="1" Style="{StaticResource Card}"
            Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="本机还没有简报" FontSize="14" Foreground="{StaticResource Muted}"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptyHint" FontSize="11" Margin="0,8,0,0" TextAlignment="Center"
                   Foreground="{StaticResource Faint}" TextWrapping="Wrap" MaxWidth="460" />
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- 关注动态: the account's OWN groups are its watch sectors — the
             server aggregates announcements/earnings/news for exactly those
             contracts, keyword-scored 利多/利空, refreshed hourly and pushed
             over the presence channel. -->
        <Border x:Name="WatchCard" Style="{StaticResource Card}" Margin="0,0,0,8"
                Visibility="Collapsed">
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="关注动态" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleGradient}" VerticalAlignment="Center" />
                <TextBlock x:Name="WatchUpdated" FontSize="11" Margin="10,0,0,0"
                           Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox x:Name="WatchFilter" Width="110" Height="28" FontSize="12"
                          SelectionChanged="WatchFilter_Changed">
                  <ComboBoxItem Content="全部" IsSelected="True" />
                  <ComboBoxItem Content="利多" />
                  <ComboBoxItem Content="利空" />
                  <ComboBoxItem Content="公告与业绩" />
                </ComboBox>
                <ui:Button Height="28" Width="32" Padding="0" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon ArrowSync24}" Click="WatchRefresh_Click"
                           ToolTip="立即刷新关注动态" />
              </StackPanel>
            </Grid>
            <TextBlock x:Name="WatchHint" FontSize="11" Foreground="{StaticResource Faint}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel x:Name="WatchBody" />
          </StackPanel>
        </Border>

        <StackPanel x:Name="Sections" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
