<Window x:Class="StockClient.App.Views.StealthFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="面板字段与颜色" Width="1080" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#12161F" FontFamily="Microsoft YaHei" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="16,14">
    <TextBlock Text="点击字段块勾选/取消显示，按住拖动调整顺序（面板按此顺序显示），双击字段块修改颜色。"
               Foreground="#8B93A3" FontSize="11" Margin="0,0,0,10" />

    <!-- ItemsControl, not ListBox: no selection visuals to fight the chips. All
         chips visible at once — this window exists so the list never scrolls. -->
    <ItemsControl x:Name="FieldChips" Background="Transparent">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="#1B2233" BorderBrush="#2C3547" BorderThickness="1"
                  CornerRadius="4" Padding="8,5" Margin="0,0,6,6">
            <StackPanel Orientation="Horizontal">
              <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" MinWidth="0"
                        VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" Margin="5,0,7,0" VerticalAlignment="Center"
                         Foreground="#EDF1F7" />
              <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                      Background="{Binding Swatch1}" />
              <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                      Margin="3,0,0,0" Background="{Binding Swatch2}"
                      Visibility="{Binding Swatch2Visible}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal">
        <Button Content="全选" Padding="14,3" Click="FieldsAll_Click" />
        <Button Content="全清" Padding="14,3" Margin="8,0,0,0" Click="FieldsNone_Click"
                ToolTip="保留「合约名称」——面板每行至少要显示一个字段" />
        <Button Content="默认" Padding="14,3" Margin="8,0,0,0" Click="FieldsDefault_Click"
                ToolTip="恢复默认的字段选择、顺序与颜色" />
        <Button Content="一键排序" Padding="14,3" Margin="8,0,0,0" Click="FieldsCompact_Click"
                ToolTip="勾选的字段按现有相对顺序排到前面，未勾选的按相对顺序紧随其后" />
      </StackPanel>
      <Button Content="完成" Padding="14,3" HorizontalAlignment="Right" Click="Done_Click" />
    </Grid>
  </StackPanel>
</Window>
