<Window x:Class="StockClient.App.Views.ColumnSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="列设置" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#12161F" FontFamily="Microsoft YaHei" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="16,14">
    <TextBlock Text="勾选控制显示，按住拖动调整列顺序；改动即时生效并自动保存。"
               Foreground="#8B93A3" FontSize="11" Margin="0,0,0,10" />

    <!-- ItemsControl, not ListBox: no selection visuals to fight with the chips. -->
    <ItemsControl x:Name="Chips" Background="Transparent">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="#1B2233" BorderBrush="#2C3547" BorderThickness="1"
                  CornerRadius="4" Padding="8,5" Margin="0,0,6,6">
            <StackPanel Orientation="Horizontal">
              <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Header}" Margin="5,0,0,0" VerticalAlignment="Center"
                         Foreground="#EDF1F7" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal">
        <ui:Button Content="全选" Height="28" Padding="14,0" FontSize="12" Click="All_Click" />
        <ui:Button Content="全清" Height="28" Padding="14,0" Margin="8,0,0,0" FontSize="12" Click="None_Click" />
        <ui:Button Content="A股" Height="28" Padding="14,0" Margin="8,0,0,0" FontSize="12" Click="AShare_Click"
                   ToolTip="A股分组预设：显示概念/行业/换手/量比等 A 股专有列" />
        <ui:Button Content="海外" Height="28" Padding="14,0" Margin="8,0,0,0" FontSize="12" Click="Overseas_Click"
                   ToolTip="港/美/韩分组预设：隐藏 A 股专有列，显示 52 周高低等海外有值字段" />
        <ui:Button Content="默认" Height="28" Padding="14,0" Margin="8,0,0,0" FontSize="12" Click="Default_Click"
                   ToolTip="代码、名称、最新价、涨跌幅、涨跌、行业" />
      </StackPanel>
      <ui:Button Content="关闭" Height="28" Padding="14,0" FontSize="12"
                 HorizontalAlignment="Right" Click="Close_Click" />
    </Grid>
  </StackPanel>
</Window>
