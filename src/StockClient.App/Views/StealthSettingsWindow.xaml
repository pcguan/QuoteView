<Window x:Class="StockClient.App.Views.StealthSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="简洁面板设置" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#12161F" FontFamily="Microsoft YaHei" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="18,16">
    <TextBlock Text="模板" Foreground="#EDF1F7" Margin="0,0,0,6" />
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="TemplateBox" Grid.Column="0"
                SelectionChanged="TemplateBox_SelectionChanged" />
      <Button Grid.Column="1" Content="另存为…" Margin="6,0,0,0" Click="TemplateSave_Click"
              ToolTip="把当前面板设置保存为一个新模板" />
      <Button Grid.Column="2" Content="删除" Margin="6,0,0,0" Click="TemplateDelete_Click"
              ToolTip="删除当前选中的模板" />
    </Grid>

    <Grid Margin="0,0,0,6">
      <TextBlock Text="显示行数" VerticalAlignment="Center" Foreground="#EDF1F7" />
      <TextBlock x:Name="RowsValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Foreground="#8B93A3" />
    </Grid>
    <Slider x:Name="RowsSlider" Minimum="1" Maximum="20"
            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,16" />

    <Grid Margin="0,0,0,6">
      <TextBlock Text="行距" VerticalAlignment="Center" Foreground="#EDF1F7" />
      <TextBlock x:Name="RowGapValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Foreground="#8B93A3" />
    </Grid>
    <Slider x:Name="RowGapSlider" Minimum="0" Maximum="20"
            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8" />

    <!-- Live preview: the sample rows take the current gap so the setting is visible. -->
    <Border Background="#0F1420" CornerRadius="4" Padding="10,7" Margin="0,0,0,16">
      <StackPanel x:Name="GapPreview" />
    </Border>

    <Grid Margin="0,0,0,6">
      <TextBlock Text="透明度" VerticalAlignment="Center" Foreground="#EDF1F7" />
      <TextBlock x:Name="ShadeValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Foreground="#8B93A3" />
    </Grid>
    <Slider x:Name="ShadeSlider" Minimum="0" Maximum="10"
            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,14" />

    <TextBlock Text="面板图表（当前合约）　Win+Alt+Delete 循环切换" Foreground="#EDF1F7"
               Margin="0,0,0,6" />
    <StackPanel x:Name="ChartChoice" Orientation="Horizontal" Margin="0,0,0,18">
      <RadioButton x:Name="ChartNone" Content="关闭" GroupName="chart"
                   Foreground="#EDF1F7" Margin="0,0,14,0" />
      <RadioButton x:Name="ChartTrend" Content="分时缩略图" GroupName="chart"
                   Foreground="#EDF1F7" Margin="0,0,14,0" />
      <RadioButton x:Name="ChartDepth" Content="五档盘口" GroupName="chart"
                   Foreground="#EDF1F7" />
    </StackPanel>

    <TextBlock Text="显示字段与颜色" Foreground="#EDF1F7" Margin="0,0,0,10" />
    <!--
      Scrolls: with ~20 fields the list would otherwise run off the screen.
      HorizontalScrollBarVisibility must be Disabled, not left at its default
      Hidden: Hidden still measures the rows against infinite width, so they
      never shrink to the viewport and the colour pickers on the right get cut
      off. Disabled is the one that constrains.
    -->
    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="FieldsPanel" Margin="0,0,6,0" />
    </ScrollViewer>

    <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#5F6672" TextWrapping="Wrap"
               Text="改动即时生效，自动保存。至少保留一个字段。" />
  </StackPanel>
</Window>
