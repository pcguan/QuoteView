<Window x:Class="StockClient.App.Views.AddContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="新增合约" Width="460" Height="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        Background="#12161F" Foreground="#EDF1F7" FontFamily="Microsoft YaHei"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="GroupText" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <ui:Button x:Name="AddButton" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Add24}"
                 ToolTip="添加到当前分组" Margin="8,0,0,0" IsEnabled="False" Click="Add_Click" />
      <ui:TextBox x:Name="SearchBox" PlaceholderText="代码 / 名称 / 拼音"
                  TextChanged="Search_Changed" PreviewKeyDown="Search_KeyDown" />
    </DockPanel>
    <ListBox x:Name="Matches" Grid.Row="2" Background="#1B2233" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="Matches_DoubleClick" PreviewKeyDown="Matches_KeyDown">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="2,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="112" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Code}" Foreground="#8B93A3" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#EDF1F7" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding TypeDisplay}" Foreground="#8B93A3" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="ResultText" Grid.Row="3" MinHeight="22" Margin="0,8,0,0"
               TextWrapping="Wrap" Foreground="#8B93A3" />
  </Grid>
</Window>
