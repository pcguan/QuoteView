<UserControl x:Class="StockClient.App.Views.TradeTapeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Virtualized: a full running day is a few thousand rows, refreshed every 5s
       live, so only the visible rows are ever realized. -->
  <ItemsControl x:Name="List"
                VirtualizingStackPanel.IsVirtualizing="True"
                VirtualizingStackPanel.VirtualizationMode="Recycling">
    <ItemsControl.Template>
      <ControlTemplate TargetType="ItemsControl">
        <!-- CanContentScroll MUST live on the actual ScrollViewer: the attached
             value on the ItemsControl does not flow into a hard-coded template
             scroller, and without item-based scrolling the VirtualizingStackPanel
             gets an infinite viewport and realizes every row (defeating the whole
             point). -->
        <ScrollViewer x:Name="TapeScroll" CanContentScroll="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ItemsPresenter />
        </ScrollViewer>
      </ControlTemplate>
    </ItemsControl.Template>
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <!-- 16px right inset keeps 量 clear of the overlay scrollbar. Price sits
             left-aligned right after the time; the star column opens the gap
             between price and 量 (which the reader compares down the column). -->
        <Grid Margin="0,1,16,1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="52" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Time}" Foreground="#6E7686" FontSize="11" />
          <TextBlock Grid.Column="1" Text="{Binding Price}" Foreground="{Binding Fg}"
                     FontSize="11" FontWeight="{Binding Weight}" Margin="8,0,0,0" />
          <TextBlock Grid.Column="2" Text="{Binding Volume}" Foreground="{Binding Fg}"
                     FontSize="11" FontWeight="{Binding Weight}" TextAlignment="Right" />
        </Grid>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
