<UserControl x:Class="StockClient.App.Views.TradeTapeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Virtualized: a full running day is a few thousand rows, refreshed every 5s
       live, so only the visible rows are ever realized. -->
  <ItemsControl x:Name="List"
                VirtualizingStackPanel.IsVirtualizing="True"
                VirtualizingStackPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True">
    <ItemsControl.Template>
      <ControlTemplate TargetType="ItemsControl">
        <ScrollViewer x:Name="TapeScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ItemsPresenter />
        </ScrollViewer>
      </ControlTemplate>
    </ItemsControl.Template>
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Grid Background="{Binding Background}" Margin="0,1,0,1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="46" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Time}" Foreground="#6E7686" FontSize="11" />
          <TextBlock Grid.Column="1" Text="{Binding Price}" Foreground="{Binding Fg}"
                     FontSize="11" FontWeight="{Binding Weight}" TextAlignment="Right" Margin="6,0,0,0" />
          <TextBlock Grid.Column="2" Text="{Binding Volume}" Foreground="{Binding Fg}"
                     FontSize="11" FontWeight="{Binding Weight}" TextAlignment="Right" Margin="6,0,0,0" />
        </Grid>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
