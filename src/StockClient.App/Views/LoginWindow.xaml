<Window x:Class="StockClient.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账户" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#12161F" FontFamily="Microsoft YaHei" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="20,18">
    <!-- Signed-in header: who + actions. Sub-forms stay collapsed until asked. -->
    <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">
      <TextBlock x:Name="SignedInText" Foreground="#EDF1F7" FontSize="14" />
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="修改密码" Click="ChangePassToggle_Click" />
        <Button Content="切换账号" Margin="8,0,0,0" Click="SwitchToggle_Click" />
        <Button Content="退出登录" Margin="8,0,0,0" Click="SignOut_Click" />
      </StackPanel>

      <StackPanel x:Name="ChangePassPanel" Visibility="Collapsed" Margin="0,14,0,0">
        <TextBlock Text="旧密码" Foreground="#5F6672" FontSize="11" Margin="0,0,0,2" />
        <PasswordBox x:Name="OldPassBox" Margin="0,0,0,8" />
        <TextBlock Text="新密码（至少 6 位）" Foreground="#5F6672" FontSize="11" Margin="0,0,0,2" />
        <PasswordBox x:Name="NewPassBox" Margin="0,0,0,8" />
        <TextBlock Text="确认新密码" Foreground="#5F6672" FontSize="11" Margin="0,0,0,2" />
        <PasswordBox x:Name="NewPass2Box" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ChangePassButton" Content="确认修改" Click="ChangePass_Click" />
          <TextBlock x:Name="ChangePassResult" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <!-- Quick switch: one button per remembered account, then the manual door. -->
    <StackPanel x:Name="SwitchPanel" Visibility="Collapsed">
      <TextBlock x:Name="SwitchTitle" Text="选择账户" Foreground="#8B93A3" Margin="0,0,0,8" />
      <StackPanel x:Name="SavedList" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <Button Content="其他账户…" Click="OtherAccount_Click" />
        <Button Content="离线模式" Margin="8,0,0,0" Click="Offline_Click"
                ToolTip="不登录，使用本机独立的离线档案（分组、合约、个性化配置都只存在本机，与账户数据互不影响）" />
      </StackPanel>
      <TextBlock x:Name="SwitchResult" Foreground="#EF5350" TextWrapping="Wrap"
                 Margin="0,8,0,0" Visibility="Collapsed" />
    </StackPanel>

    <!-- Manual credentials form. -->
    <StackPanel x:Name="FormPanel" Visibility="Collapsed">
      <TextBlock Text="用户名" Foreground="#8B93A3" Margin="0,0,0,4" />
      <TextBox x:Name="UserBox" Margin="0,0,0,12" />

      <TextBlock Text="密码" Foreground="#8B93A3" Margin="0,0,0,4" />
      <PasswordBox x:Name="PassBox" Margin="0,0,0,12" KeyDown="PassBox_KeyDown" />

      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <CheckBox x:Name="RememberBox" Content="记住密码" Foreground="#EDF1F7"
                  IsChecked="True" Checked="Remember_Changed" Unchecked="Remember_Changed" />
        <CheckBox x:Name="AutoLoginBox" Content="自动登录" Foreground="#EDF1F7"
                  IsChecked="True" Margin="16,0,0,0" />
      </StackPanel>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="LoginButton" Grid.Column="0" Content="登录" Margin="0,0,4,0"
                HorizontalAlignment="Stretch" Click="Login_Click" />
        <Button x:Name="RegisterButton" Grid.Column="1" Content="注册并登录" Margin="4,0,0,0"
                HorizontalAlignment="Stretch" Click="Register_Click" />
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="BackToListButton" Content="← 返回账户列表"
                Visibility="Collapsed" Click="BackToList_Click" />
        <Button x:Name="OfflineFormButton" Content="离线模式" Margin="0,0,0,0"
                Click="Offline_Click"
                ToolTip="不登录，使用本机独立的离线档案（分组、合约、个性化配置都只存在本机，与账户数据互不影响）" />
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="ErrorText" Foreground="#EF5350" TextWrapping="Wrap"
               Margin="0,10,0,0" Visibility="Collapsed" />
    <TextBlock FontSize="11" Foreground="#5F6672" TextWrapping="Wrap" Margin="0,12,0,0"
               Text="账户用于多端同步分组与查询服务端归档的历史分时。凭据仅保存在本机（Windows DPAPI 加密）。" />
  </StackPanel>
</Window>
