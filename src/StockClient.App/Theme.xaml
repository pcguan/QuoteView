<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:StockClient.App">



  <!--
    Only app-specific pieces live here. The base control templates (TextBox,
    ComboBox, DataGrid, ScrollBar) come from WPF UI's dictionary, which is merged
    first in App.xaml — hand-rolled templates were what made the old build look
    like a Win32 app.
  -->

  <app:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <app:NotConverter x:Key="Not" />
  <app:ConceptsToTagsConverter x:Key="ConceptsToTags" />
  <app:SignToBrushConverter x:Key="SignToBrush" />
  <app:PriceConverter x:Key="Price" />
  <app:PctConverter x:Key="Pct" />
  <app:SignedConverter x:Key="Signed" />
  <app:NumConverter x:Key="Num" />

  <SolidColorBrush x:Key="Muted" Color="#8B93A3" />
  <SolidColorBrush x:Key="Faint" Color="#5F6672" />
  <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />

  <!-- Card surface: subtle top-lit gradient so panels read as raised. -->
  <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#1C2230" />
    <GradientStop Offset="1" Color="#161B26" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#7FB2FF" />
    <GradientStop Offset="1" Color="#4C8DFF" />
  </LinearGradientBrush>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBg}" />
    <Setter Property="BorderBrush" Value="#2A3142" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- 概念标签胶囊 -->
  <Style x:Key="TagChip" TargetType="Border">
    <Setter Property="Background" Value="#243046" />
    <Setter Property="BorderBrush" Value="#33405C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>

  <!-- 市场状态徽章 -->
  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="Background" Value="#1E2534" />
    <Setter Property="BorderBrush" Value="#2C3547" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <!-- 呼吸灯：加载中缓慢脉动，就绪后停在稳定态 -->
  <Style x:Key="BreathingDot" TargetType="Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="#3DD68C" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Loading}" Value="True">
        <Setter Property="Fill" Value="{StaticResource Accent}" />
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="Breathe">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               From="1" To="0.15" Duration="0:0:1.1"
                               AutoReverse="True" RepeatBehavior="Forever" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="Breathe" />
        </DataTrigger.ExitActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
