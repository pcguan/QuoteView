<ui:FluentWindow x:Class="StockClient.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:StockClient.App.Views"
                 Title="QuoteView" Height="760" Width="1500"
                 MinHeight="520" MinWidth="900"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="#12161F"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 FontFamily="Microsoft YaHei" FontSize="13"
                 TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="QuoteView" ShowMaximize="True">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="DataTrending24" />
      </ui:TitleBar.Icon>
      <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,140,0">
          <ui:Button x:Name="UpdateButton" Height="26" Padding="8,0" Margin="0,0,8,0"
                     Icon="{ui:SymbolIcon ArrowSync24}" Content="检查更新" FontSize="11"
                     Click="CheckUpdate_Click" ToolTip="检查 GitHub 上是否有新版本" />
          <ui:Button Height="26" Padding="8,0" Icon="{ui:SymbolIcon Settings24}"
                     Content="面板设置" FontSize="11" Click="StealthSettings_Click"
                     ToolTip="配置简洁面板：显示行数、字段、颜色、透明度" />
          <ui:Button Height="26" Padding="8,0" Margin="8,0,0,0"
                     Icon="{ui:SymbolIcon EyeOff24}" Content="简洁面板" FontSize="11"
                     Click="Stealth_Click"
                     ToolTip="切到桌面置顶单行行情，主窗口退到后台&#10;Win+Alt+End 主窗口/面板互切 · Win+Alt+↑/↓ 变亮/变暗 · Win+Alt+←/→ 切合约 · Win+Alt+PageUp/PageDown 切分组 · 右键面板或托盘图标还原" />
        </StackPanel>
      </ui:TitleBar.Header>
    </ui:TitleBar>

    <TabControl Grid.Row="1" Margin="16,0,16,0" Background="Transparent" BorderThickness="0">
      <TabItem Header="实时行情">
        <views:QuotesView x:Name="Quotes" Margin="-16,0,-16,0" />
      </TabItem>
      <TabItem Header="资讯">
        <views:BriefView x:Name="Brief" Margin="-16,0,-16,0" />
      </TabItem>
      <TabItem Header="合约查询">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,4,0,8">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="合约查询" FontSize="19" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleGradient}" />
            <Border Style="{StaticResource Badge}" Margin="12,0,0,0" Padding="8,2">
              <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource BreathingDot}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" Margin="7,0,0,0" FontSize="11"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding ResultSummary}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="条结果" FontSize="11" Margin="5,0,0,3" VerticalAlignment="Bottom"
                       Foreground="{StaticResource Faint}" />
          </StackPanel>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ComboBox Grid.Column="0" Width="128" Height="36" Margin="0,0,10,0"
                    ItemsSource="{Binding Markets}"
                    SelectedItem="{Binding SelectedMarket, Mode=TwoWay}"
                    IsEnabled="{Binding Loading, Converter={StaticResource Not}}"
                    ToolTip="按交易所过滤" />

          <ComboBox Grid.Column="1" Width="128" Height="36" Margin="0,0,10,0"
                    ItemsSource="{Binding Types}"
                    SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                    IsEnabled="{Binding Loading, Converter={StaticResource Not}}"
                    ToolTip="按合约类型过滤" />

          <ui:TextBox Grid.Column="2" x:Name="SearchBox" Height="36"
                      PlaceholderText="搜索合约编码或名称，如 600519 / 茅台 / gzmt"
                      Icon="{ui:SymbolIcon Search24}"
                      ClearButtonEnabled="True"
                      Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding Loading, Converter={StaticResource Not}}" />

          <ui:Button Grid.Column="3" x:Name="ClearButton" Margin="10,0,0,0"
                     Height="36" Width="42" Padding="0"
                     Icon="{ui:SymbolIcon ArrowReset24}"
                     Click="ClearButton_Click"
                     IsEnabled="{Binding CanClear}"
                     ToolTip="清空所有筛选条件（交易所、类型、关键词、排序）" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="0">
      <DataGrid x:Name="ResultGrid"
                ItemsSource="{Binding Results}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                Background="Transparent"
                BorderThickness="0"
                RowHeight="30"
                CanUserAddRows="False"
                SelectionMode="Single"
                EnableRowVirtualization="True"
                CanUserSortColumns="True"
                Sorting="ResultGrid_Sorting"
                MouseDoubleClick="ResultGrid_DoubleClick"
                Loaded="ResultGrid_Loaded">
        <DataGrid.Columns>
          <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="112" MinWidth="92" SortMemberPath="Code">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150" MinWidth="70" SortMemberPath="Name">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTemplateColumn Header="类型" Width="82" MinWidth="64" SortMemberPath="Type">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource TagChip}" HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding TypeDisplay}" FontSize="11" Foreground="#9FC2FF" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="行业" Binding="{Binding Industry}" Width="108" MinWidth="72" SortMemberPath="Industry">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTemplateColumn Header="概念" Width="*" SortMemberPath="Concepts">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ItemsControl ItemsSource="{Binding Concepts, Converter={StaticResource ConceptsToTags}}"
                              VerticalAlignment="Center" ToolTip="{Binding Concepts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource TagChip}">
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#A8B4C8" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="地区" Binding="{Binding Region}" Width="84" MinWidth="64" SortMemberPath="Region">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Header="总股本" Binding="{Binding TotalSharesDisplay}" Width="80" MinWidth="68" SortMemberPath="TotalShares">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Header="流通股" Binding="{Binding FloatSharesDisplay}" Width="80" MinWidth="68" SortMemberPath="FloatShares">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Header="上市日期" Binding="{Binding ListedOn}" Width="96" MinWidth="84" SortMemberPath="ListedOn">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Header="交易所" Binding="{Binding Market}" Width="72" MinWidth="60" SortMemberPath="Market">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding Loading, Converter={StaticResource BoolToVisibility}}">
      <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42" />
      <TextBlock Text="正在从东财拉取各交易所合约列表…" Margin="0,14,0,0"
                 Foreground="{StaticResource Muted}" />
    </StackPanel>

    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="{StaticResource Faint}" TextAlignment="Center"
               Text="没有匹配的合约&#10;试试 600519 / 茅台 / gzmt / SH600519">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Loading}" Value="False" />
                <Condition Binding="{Binding Results.Count}" Value="0" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <ItemsControl Grid.Row="2" ItemsSource="{Binding MarketStatuses}" Margin="0,0,0,14">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Badge}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Display}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="Bold"
                         Foreground="{StaticResource Accent}" Margin="8,0,4,0" />
              <TextBlock Text="{Binding Detail}" FontSize="11"
                         Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Bottom status bar: update prompt. Collapsed until a newer version is found. -->
    <Border x:Name="UpdateBar" Grid.Row="2" Visibility="Collapsed"
            Background="#1B2233" BorderBrush="#2C3547" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="ArrowSync24" Foreground="#4C8DFF" VerticalAlignment="Center" />
          <TextBlock x:Name="UpdateBarText" Margin="9,0,0,0" VerticalAlignment="Center"
                     Foreground="#EDF1F7" FontSize="12" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <ui:Button x:Name="UpdateBarUpdate" Content="更新" Appearance="Primary"
                     Height="28" Padding="16,0" FontSize="12" Click="UpdateBar_Update" />
          <ui:Button Content="关闭" Height="28" Padding="12,0" Margin="8,0,0,0" FontSize="12"
                     Click="UpdateBar_Dismiss" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
