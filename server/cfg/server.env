# QuoteView 快照服务端配置（compose env_file 加载）
TZ=Asia/Shanghai
QV_PORT=8388
# 监听地址：默认 127.0.0.1（只允许同机 nginx 反代）；NAS 上配 0.0.0.0
# 以便外网断时可从内网直连 http://<NAS内网IP>:8388/web/（裸 HTTP，注意仅限可信局域网）
QV_BIND=0.0.0.0
QV_DATA=/data
QV_LOG=/log/server.log
# 每合约快照保留天数
QV_RETAIN_DAYS=7
# 相邻两次东财请求的间隔（秒）
QV_FETCH_GAP=1.5
# Web 管理台口令（HTTP Basic，用户名任意）。仓库不放真实值，只在 NAS 的这份里填。
# QV_ADMIN_PASSWORD=
# Web 管理台中隐藏的测试账户（逗号分隔）
QV_HIDDEN_ACCOUNTS=qa_probe
